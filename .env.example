# Copy to `.env` and change the passwords. Never commit `.env`.
# Placeholder values only — safe to copy as-is for local Docker.

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=portfolio
MYSQL_USER=app
MYSQL_PASSWORD=changeme
DATABASE_URL=mysql://app:changeme@127.0.0.1:3306/portfolio
DATABASE_URL_TEST=mysql://app:changeme@127.0.0.1:3307/portfolio_test
MYSQL_DATABASE_TEST=portfolio_test
SEED_PROFILE=demo

API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:4000

# Set to 1 to print every Prisma SQL query (T34). Leave off in production.
PRISMA_LOG_QUERIES=

# Auth (T35). Generate secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ADMIN_EMAIL="<email>"
ADMIN_NAME=
ADMIN_PASSWORD=

