# Copy to `.env` and change the passwords. Never commit `.env`.
# Placeholder values only — safe to copy as-is for local Docker.

MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=portfolio
MYSQL_USER=app
MYSQL_PASSWORD=changeme
DATABASE_URL=mysql://app:changeme@127.0.0.1:3306/portfolio
DATABASE_URL_TEST=mysql://app:changeme@127.0.0.1:3307/portfolio_test
MYSQL_DATABASE_TEST=portfolio_test
SEED_PROFILE=demo

API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
API_URL=http://127.0.0.1:4000

# Set to 1 to print every Prisma SQL query (T34). Leave off in production.
PRISMA_LOG_QUERIES=

# Auth (T35 / T59). Generate secrets with: openssl rand -base64 48
# Production pair must differ from each other and from local-dev. See
# docs/runbooks/secrets.md. Boot fails if they are short or equal.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
ADMIN_EMAIL="<email>"
ADMIN_NAME=
ADMIN_PASSWORD=

# Media (T50). Files go to Cloudinary — never the API disk. Leave blank locally
# to use the in-memory test storage (URLs under https://media.test/…).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Publish (T52). API POSTs to WEB_INTERNAL_URL/api/revalidate with this secret.
# Leave blank locally — failed revalidate is logged and never blocks a write.
WEB_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=

# Public site URL used as metadataBase, canonical, sitemap and OG (T53).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (T54). Daily salt for cookieless visitor hashes. Leave blank to skip writes.
ANALYTICS_SALT_SECRET=

# Production compose (T58). `pnpm prod:up` reads the MYSQL_* and JWT_* keys
# above. These override the local :3000 URLs so Caddy on :80 is the origin.
# WEB_ORIGIN_PROD=http://localhost
# NEXT_PUBLIC_SITE_URL_PROD=http://localhost
# NEXT_PUBLIC_BUILD_SHA=

