{
  "name": "@parker2808/cms-core",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.cjs"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react/server": {
      "types": "./dist/react/server.d.ts",
      "import": "./dist/react/server.js",
      "require": "./dist/react/server.cjs"
    },
    "./theme.css": "./dist/theme.css"
  },
  "sideEffects": [
    "./dist/theme.css"
  ],
  "typesVersions": {
    "*": {
      "contracts": [
        "dist/contracts.d.ts"
      ],
      "engine": [
        "dist/engine.d.ts"
      ],
      "react": [
        "dist/react.d.ts"
      ],
      "react/server": [
        "dist/react/server.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup && node scripts/measure-cms-core.mjs",
    "lint": "eslint .",
    "check:deps": "node scripts/check-deps.mjs && node --test scripts/check-deps.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs scripts/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.0.0"
  }
}
