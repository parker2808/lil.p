{
  "name": "@parker2808/cms-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "require": "./dist/contracts.cjs"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "require": "./dist/engine.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react/server": {
      "types": "./dist/react/server.d.ts",
      "import": "./dist/react/server.js",
      "require": "./dist/react/server.cjs"
    },
    "./theme.css": "./dist/theme.css"
  },
  "sideEffects": [
    "./dist/theme.css"
  ],
  "typesVersions": {
    "*": {
      "contracts": [
        "dist/contracts.d.ts"
      ],
      "engine": [
        "dist/engine.d.ts"
      ],
      "react": [
        "dist/react.d.ts"
      ],
      "react/server": [
        "dist/react/server.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/measure-cms-core.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs ../../scripts/measure-cms-core.test.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "zod": "^4.0.0"
  }
}
