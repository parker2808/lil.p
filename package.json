{
  "name": "lil.p",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --if-present --parallel dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @portfolio/contracts build && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "db:up": "docker compose up -d db adminer",
    "db:test:up": "docker compose --profile test up -d db-test",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db adminer",
    "db:migrate": "pnpm --filter @portfolio/api db:migrate",
    "db:reset": "pnpm --filter @portfolio/api db:reset",
    "db:seed": "pnpm --filter @portfolio/api db:seed",
    "db:studio": "pnpm --filter @portfolio/api db:studio",
    "check:content": "node scripts/check-content.mjs",
    "check:deps": "node scripts/check-deps.mjs && node --test scripts/check-deps.test.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@swc/core",
      "prisma",
      "@prisma/engines",
      "@prisma/client",
      "argon2"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
