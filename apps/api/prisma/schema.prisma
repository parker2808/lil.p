// Database definition. `pnpm db:migrate` turns edits here into SQL in
// prisma/migrations/. Conventions come from spec §1.5 and PLAN T08 / D26.
//
// Beginner notes:
// - `id Int @id @default(autoincrement())` → 1, 2, 3… (easy to read in Adminer)
// - `createdAt` / `updatedAt` are filled by Prisma
// - Two columns per translated text (`titleEn`, `titleVi`)
// - Singletons (`SiteSettings`, `Profile`) are one row with `id = 1`
// - Tables map to snake_case; columns stay camelCase

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Availability {
  OPEN
  NOT_LOOKING
  FREELANCE

  @@map("availability")
}

enum NavLocation {
  HEADER
  FOOTER

  @@map("nav_location")
}

enum SocialKind {
  GITHUB
  LINKEDIN
  EMAIL
  RSS
  OTHER

  @@map("social_kind")
}

enum PageKey {
  HOME
  ABOUT
  PROJECTS
  NOTES
  CONTACT

  @@map("page_key")
}

enum LayoutPreset {
  ONE
  TWO
  THREE
  FOUR
  SPLIT_8_4
  SPLIT_4_8
  SPLIT_7_5

  @@map("layout_preset")
}

enum BlockSurface {
  PLAIN
  BAND

  @@map("block_surface")
}

/// Site-wide settings. Exactly one row (`id = 1`), created by the seed.
model SiteSettings {
  id                 Int          @id @default(autoincrement())
  siteName           String
  domain             String
  defaultLocale      String       @default("en") @db.VarChar(8)
  seoTitleEn         String
  seoTitleVi         String
  seoDescriptionEn   String       @db.Text
  seoDescriptionVi   String       @db.Text
  ogImageId          Int?
  ogImage            Media?       @relation("SiteOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  footerNoteEn       String
  footerNoteVi       String
  contactIntroEn     String       @db.Text
  contactIntroVi     String       @db.Text
  replyTimeNoteEn    String
  replyTimeNoteVi    String
  contactEmail       String
  availability       Availability @default(OPEN)
  availabilityNoteEn String
  availabilityNoteVi String
  analyticsEnabled   Boolean      @default(false)
  ambientEffects     Boolean      @default(true)
  marqueeEnabled     Boolean      @default(true)
  /// Up to 3 `{ value, suffix?, labelEn, labelVi }` (contracts `heroStatsSchema`). NULL = use profile stats.
  heroStats          Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("site_settings")
}

/// Public profile. Exactly one row (`id = 1`). `phone` is private — mappers drop it.
model Profile {
  id                Int      @id @default(autoincrement())
  displayName       String
  legalName         String
  city              String
  country           String
  timezone          String
  careerStartDate   DateTime @db.Date
  headlineEn        String   @db.Text
  headlineVi        String   @db.Text
  subheadlineEn     String   @db.Text
  subheadlineVi     String   @db.Text
  bioEn             String   @db.Text
  bioVi             String   @db.Text
  languagesEn       String
  languagesVi       String
  heroKickerEn      String?
  heroKickerVi      String?
  headlineAccentEn  String?
  headlineAccentVi  String?
  avatarId          Int?
  avatar            Media?   @relation("ProfileAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  resumeEnId        Int?
  resumeEn          Media?   @relation("ProfileResumeEn", fields: [resumeEnId], references: [id], onDelete: SetNull)
  resumeViId        Int?
  resumeVi          Media?   @relation("ProfileResumeVi", fields: [resumeViId], references: [id], onDelete: SetNull)
  phone             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("profile")
}

model NavItem {
  id        Int         @id @default(autoincrement())
  location  NavLocation
  labelEn   String
  labelVi   String
  href      String
  sortOrder Int         @default(0)
  isVisible Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([location, sortOrder])
  @@map("nav_item")
}

model SocialLink {
  id           Int        @id @default(autoincrement())
  kind         SocialKind
  labelEn      String
  labelVi      String
  url          String
  showInHeader Boolean    @default(false)
  showInCta    Boolean    @default(false)
  sortOrder    Int        @default(0)
  isVisible    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([sortOrder])
  @@map("social_link")
}

model ContactTopic {
  id        Int              @id @default(autoincrement())
  slug      String           @unique
  labelEn   String
  labelVi   String
  sortOrder Int              @default(0)
  isVisible Boolean          @default(true)
  messages  ContactMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([sortOrder])
  @@map("contact_topic")
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  SPAM

  @@map("contact_message_status")
}

/// Visitor inbox row. Never exposed on public routes. `ipHash` is SHA-256(IP + daily salt).
model ContactMessage {
  id        Int                   @id @default(autoincrement())
  name      String
  email     String
  topicId   Int?
  topic     ContactTopic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  message   String                @db.Text
  locale    String                @db.VarChar(8)
  status    ContactMessageStatus  @default(NEW)
  ipHash    String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([status, createdAt])
  @@map("contact_message")
}

/// One row per public route page (HOME … CONTACT).
model Page {
  id                 Int          @id @default(autoincrement())
  key                PageKey      @unique
  seoTitleEn         String?
  seoTitleVi         String?
  seoDescriptionEn   String?      @db.Text
  seoDescriptionVi   String?      @db.Text
  publishedVersionId Int?         @unique
  publishedVersion   PageVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  publishedAt        DateTime?
  blocks             PageBlock[]
  versions           PageVersion[] @relation("PageVersions")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("page")
}

/// Published copy of a page. Visitors only read snapshots; `PageBlock` rows are the draft.
model PageVersion {
  id          Int      @id @default(autoincrement())
  pageId      Int
  page        Page     @relation("PageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  note        String?  @db.VarChar(200)
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  publishedOn Page?    @relation("PublishedVersion")

  @@unique([pageId, version])
  @@index([pageId])
  @@map("page_version")
}

/// Ordered block on a page. `type` is a string (not a DB enum) so a new
/// block type later needs no migration — T10a checks it against the registry.
model PageBlock {
  id            Int          @id @default(autoincrement())
  pageId        Int
  page          Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type          String       @db.VarChar(48)
  key           String       @db.VarChar(48)
  schemaVersion Int          @default(1)
  props         Json
  layout        LayoutPreset
  surface       BlockSurface @default(PLAIN)
  sortOrder     Int          @default(0)
  isVisible     Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([pageId, key])
  @@index([pageId, sortOrder])
  @@map("page_block")
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
  FREELANCE

  @@map("employment_type")
}

enum StatSource {
  MANUAL
  YEARS_COMPUTED
  PROJECT_COUNT

  @@map("stat_source")
}

/// One role at a company. The About timeline groups rows that share `company`.
model Experience {
  id             Int            @id @default(autoincrement())
  company        String
  companyUrl     String?
  location       String
  employmentType EmploymentType
  roleEn         String
  roleVi         String
  summaryEn      String         @db.Text
  summaryVi      String         @db.Text
  highlightsEn   String         @db.Text
  highlightsVi   String         @db.Text
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  sortOrder      Int            @default(0)
  isVisible      Boolean        @default(true)
  projects       Project[]
  skills         Skill[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([startDate, sortOrder])
  @@map("experience")
}

model Education {
  id        Int      @id @default(autoincrement())
  school    String
  degreeEn  String
  degreeVi  String
  majorEn   String
  majorVi   String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("education")
}

model Principle {
  id        Int      @id @default(autoincrement())
  titleEn   String
  titleVi   String
  bodyEn    String   @db.Text
  bodyVi    String   @db.Text
  iconKey   String   @db.VarChar(48)
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("principle")
}

/// Home stats. `YEARS_COMPUTED` and `PROJECT_COUNT` are resolved on read.
model ProfileStat {
  id        Int        @id @default(autoincrement())
  labelEn   String
  labelVi   String
  value     String?
  suffix    String?
  source    StatSource
  iconKey   String     @db.VarChar(48)
  sortOrder Int        @default(0)
  isVisible Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sortOrder])
  @@map("profile_stat")
}

model ProcessStep {
  id        Int      @id @default(autoincrement())
  titleEn   String
  titleVi   String
  captionEn String
  captionVi String
  iconKey   String   @db.VarChar(48)
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("process_step")
}

enum Hue {
  JADE
  AMBER
  BLUE
  VIOLET
  ROSE

  @@map("hue")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("content_status")
}

model Domain {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  nameEn      String
  nameVi      String
  descriptionEn String  @db.Text
  descriptionVi String  @db.Text
  hue         Hue
  iconKey     String    @db.VarChar(48)
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortOrder])
  @@map("domain")
}

model Project {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  titleEn         String
  titleVi         String
  taglineEn       String        @db.Text
  taglineVi       String        @db.Text
  client          String
  roleEn          String
  roleVi          String
  teamSize        Int?
  startDate       DateTime      @db.Date
  endDate         DateTime?     @db.Date
  versionFrom     String?
  versionTo       String?
  isFeatured      Boolean       @default(false)
  isConfidential  Boolean       @default(false)
  liveUrl         String?
  repoUrl         String?
  coverId         Int?
  cover           Media?        @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  images          ProjectImage[]
  problemEn       String        @db.Text
  problemVi       String        @db.Text
  constraintsEn   String        @db.Text
  constraintsVi   String        @db.Text
  approachEn      String        @db.Text
  approachVi      String        @db.Text
  decisionsEn     String        @db.Text
  decisionsVi     String        @db.Text
  outcomeEn       String        @db.Text
  outcomeVi       String        @db.Text
  lessonsEn       String        @db.Text
  lessonsVi       String        @db.Text
  keyFactsEn      String        @db.Text
  keyFactsVi      String        @db.Text
  factChipsEn     String
  factChipsVi     String
  /// Teammate / backend work that must not be shown as the owner's.
  notMineEn       String?       @db.Text
  notMineVi       String?       @db.Text
  /// `{ released: string[], notReleased: string[] }` — exact ticket/PR list from the source.
  releaseStatus   Json?
  seoTitleEn      String?
  seoTitleVi      String?
  seoDescriptionEn String?      @db.Text
  seoDescriptionVi String?      @db.Text
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  sortOrder       Int           @default(0)
  domainId        Int?
  domain          Domain?       @relation(fields: [domainId], references: [id], onDelete: SetNull)
  experienceId    Int?
  experience      Experience?   @relation(fields: [experienceId], references: [id])
  metrics         ProjectMetric[]
  skills          Skill[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, sortOrder])
  @@index([status, isFeatured, sortOrder])
  @@index([domainId])
  @@index([experienceId])
  @@map("project")
}

model ProjectMetric {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labelEn   String
  labelVi   String
  before    String?
  after     String?
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, sortOrder])
  @@map("project_metric")
}

enum SkillDepth {
  DAILY
  SHIPPED
  GROWING

  @@map("skill_depth")
}

model SkillCategory {
  id        Int      @id @default(autoincrement())
  nameEn    String
  nameVi    String
  sortOrder Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("skill_category")
}

model Skill {
  id            Int           @id @default(autoincrement())
  name          String
  slug          String        @unique
  categoryId    Int
  category      SkillCategory @relation(fields: [categoryId], references: [id])
  depth         SkillDepth
  showInMarquee Boolean       @default(false)
  sortOrder     Int           @default(0)
  isVisible     Boolean       @default(true)
  projects      Project[]
  experiences   Experience[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([categoryId, sortOrder])
  @@index([depth, sortOrder])
  @@map("skill")
}

model Tag {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameEn    String
  nameVi    String
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tag")
}

model Post {
  id               Int           @id @default(autoincrement())
  slug             String        @unique
  titleEn          String
  titleVi          String
  excerptEn        String        @db.Text
  excerptVi        String        @db.Text
  bodyEn           String        @db.Text
  bodyVi           String        @db.Text
  takeawaysEn      String        @db.Text
  takeawaysVi      String        @db.Text
  seoTitleEn       String?
  seoTitleVi       String?
  seoDescriptionEn String?       @db.Text
  seoDescriptionVi String?       @db.Text
  coverId          Int?
  cover            Media?        @relation("PostCover", fields: [coverId], references: [id], onDelete: SetNull)
  readingMinutes   Int
  isFeatured       Boolean       @default(false)
  status           ContentStatus @default(DRAFT)
  publishedAt      DateTime?
  sortOrder        Int           @default(0)
  tags             Tag[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, publishedAt, sortOrder])
  @@index([status, isFeatured, publishedAt])
  @@map("post")
}

enum Role {
  admin
  user

  @@map("role")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(user)
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  uploads      Media[]
  pageVersions PageVersion[]
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("user")
}

/// File metadata. Bytes live on Cloudinary (owner hosting); never on the API disk.
model Media {
  id           Int      @id @default(autoincrement())
  fileName     String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  altEn        String   @default("")
  altVi        String   @default("")
  resourceType String   @default("image") @db.VarChar(16)
  uploadedById Int?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  siteOg       SiteSettings[] @relation("SiteOgImage")
  avatars      Profile[]      @relation("ProfileAvatar")
  resumesEn    Profile[]      @relation("ProfileResumeEn")
  resumesVi    Profile[]      @relation("ProfileResumeVi")
  projectCovers Project[]     @relation("ProjectCover")
  postCovers   Post[]         @relation("PostCover")
  projectImages ProjectImage[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([uploadedById])
  @@map("media")
}

model ProjectImage {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   Int
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  captionEn String?
  captionVi String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, sortOrder])
  @@map("project_image")
}

enum AuditAction {
  CREATE
  UPDATE
  PUBLISH
  ARCHIVE
  RESTORE
  LOGIN

  @@map("audit_action")
}

/// Append-only admin write record. Inserted in the same transaction as the write.
model AuditLog {
  id         Int         @id @default(autoincrement())
  userId     Int?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String      @db.VarChar(64)
  entityId   String      @db.VarChar(64)
  summary    String      @db.VarChar(500)
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([entityType, id])
  @@index([userId, id])
  @@map("audit_log")
}

/// Cookieless page view. `visitorHash` is SHA-256(IP + UA + daily salt).
model PageView {
  id           Int      @id @default(autoincrement())
  path         String   @db.VarChar(200)
  locale       String   @db.VarChar(8)
  referrerHost String?  @db.VarChar(200)
  device       String   @db.VarChar(16)
  visitorHash  String   @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@map("page_view")
}
