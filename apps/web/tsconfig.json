{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@i18n/*": ["./i18n/*"],
      "@portfolio/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "app",
    "src",
    "i18n",
    "e2e",
    "proxy.ts",
    "playwright.config.ts",
    "next-env.d.ts",
    "vitest.config.mts"
  ],

  "exclude": ["node_modules", ".next"]
}
